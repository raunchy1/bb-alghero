generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Room {
  id            Int            @id @default(autoincrement())
  slug          String         @unique
  name          String
  price         Float          @default(90)
  capacity      Int            @default(2)
  createdAt     DateTime       @default(now())
  description   String?
  descriptionDe String?
  descriptionEn String?
  descriptionFr String?
  nameDe        String?
  nameEn        String?
  nameFr        String?
  updatedAt     DateTime?      @updatedAt
  bookings      Booking[]
  cleaningTasks CleaningTask[]
  priceRules    PriceRule[]
  reviews       Review[]
}

model Booking {
  id              Int             @id @default(autoincrement())
  roomId          Int
  guestName       String          @default("")
  guestEmail      String          @default("")
  checkIn         DateTime
  checkOut        DateTime
  guests          Int             @default(1)
  nights          Int             @default(1)
  totalPrice      Float           @default(0)
  paymentStatus   String          @default("pending")
  stripeSessionId String?
  createdAt       DateTime        @default(now())
  guestPhone      String?
  notes           String?
  source          String          @default("direct")
  updatedAt       DateTime?       @updatedAt
  room            Room            @relation(fields: [roomId], references: [id])
  documents       GuestDocument[]
  invoice         Invoice?
}

model GuestDocument {
  id        Int      @id @default(autoincrement())
  bookingId Int
  type      String
  number    String
  fileUrl   String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model PriceRule {
  id        Int      @id @default(autoincrement())
  roomId    Int
  startDate DateTime
  endDate   DateTime
  price     Float
  minNights Int      @default(1)
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model CleaningTask {
  id          Int       @id @default(autoincrement())
  roomId      Int
  date        DateTime
  status      String    @default("pending")
  assignedTo  String?
  notes       String?
  checklist   Json?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  room        Room      @relation(fields: [roomId], references: [id])
}

model Review {
  id          Int       @id @default(autoincrement())
  roomId      Int
  guestName   String
  guestEmail  String?
  rating      Int
  title       String?
  comment     String
  reply       String?
  isApproved  Boolean   @default(false)
  checkInDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  room        Room      @relation(fields: [roomId], references: [id])
}

model Invoice {
  id            Int      @id @default(autoincrement())
  bookingId     Int      @unique
  invoiceNumber String   @unique
  issueDate     DateTime @default(now())
  totalAmount   Float
  vatAmount     Float    @default(0)
  xmlData       String?
  status        String   @default("draft")
  createdAt     DateTime @default(now())
  booking       Booking  @relation(fields: [bookingId], references: [id])
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  titleEn   String?
  titleDe   String?
  titleFr   String?
  content   String
  contentEn String?
  contentDe String?
  contentFr String?
  excerpt   String?
  image     String?
  category  String
  published Boolean  @default(false)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  isActive  Boolean  @default(true)
  source    String   @default("website")
  createdAt DateTime @default(now())
}

model SpecialPackage {
  id            Int       @id @default(autoincrement())
  slug          String    @unique
  name          String
  description   String
  image         String?
  price         Float
  originalPrice Float?
  includes      Json
  isActive      Boolean   @default(true)
  validFrom     DateTime?
  validUntil    DateTime?
  createdAt     DateTime  @default(now())
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  sessionId String
  roomId    Int
  createdAt DateTime @default(now())

  @@unique([sessionId, roomId])
}

model Settings {
  id                  Int    @id @default(1)
  stripePublicKey     String @default("")
  stripeSecretKey     String @default("")
  whatsappNumber      String @default("+393478327243")
  propertyName        String @default("La Suite N°4")
  adminEmail          String @default("admin@lasuiten4.it")
  adminPassword       String @default("admin123")
  alloggiatiPassword  String @default("")
  alloggiatiUsername  String @default("")
  companyAddress      String @default("")
  defaultLanguage     String @default("it")
  enabledLanguages    Json   @default("[\"it\", \"en\"]")
  fiscalCode          String @default("")
  smtpFrom            String @default("booking@lasuiten4.it")
  smtpHost            String @default("")
  smtpPassword        String @default("")
  smtpPort            Int    @default(587)
  smtpUser            String @default("")
  vatNumber           String @default("")
  stripeMode          String @default("test")
  stripeTestPublicKey String @default("")
  stripeTestSecretKey String @default("")
  stripeWebhookSecret String @default("")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   Int?
  userId     String?
  details    Json?
  createdAt  DateTime @default(now())
}
